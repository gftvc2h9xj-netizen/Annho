# Database
DATABASE_URL=postgresql://dorm_user:dorm_password@db:5432/dorm_health

# Redis
REDIS_URL=redis://redis:6379

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Models
MODEL_PATH=./models/
USE_GPU=false
MODEL_CONFIDENCE_THRESHOLD=0.7

# API
API_VERSION=v1
API_TITLE=AI Dorm Health System API
API_DESCRIPTION=Smart dormitory health management platform

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:80"]
CORS_CREDENTIALS=true
